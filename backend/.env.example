
TITLE_API="API Tracking Habitos"
VERSION=0.1.0

APIKEY_OPENAI=

URL_SITE=http://localhost:3000
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000

PORT=8000

# Firma los JWT y las cookies de sesión. Obligatorio: la app no arranca sin esto.
# Generar uno distinto por entorno con:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_JWT=

# Sesion web/PWA revocable. En produccion debe usarse HTTPS y cookie segura.
SESSION_COOKIE_NAME=tcl_session
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
ACCESS_TOKEN_MINUTES=15
SESSION_COOKIE_SECURE=false

# Web Push para PWA. Generar el par una sola vez con:
#   python scripts/generate_vapid.py
# VAPID_SUBJECT debe ser mailto:correo@dominio.cl o una URL https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
TRAINING_REMINDER_FIRST_MINUTES=60
TRAINING_REMINDER_SECOND_MINUTES=120
PUSH_WORKER_POLL_SECONDS=20
PUSH_MAX_ATTEMPTS=3

# Conección con base de datos
DATABASE_URL=
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_PORT=5432
DATABASE_HOST=localhost


# Credenciales de Evolution API WhatsApp
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
