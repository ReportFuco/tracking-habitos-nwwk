# Notas operativas de la raiz. Pueden contener credenciales y no deben salir del equipo.
# La auditoria saneada es la unica excepcion versionable dentro de docs/.
/docs/*
!/docs/auditoria/
!/docs/auditoria/**

# Red de seguridad: ningun .env real se versiona, solo los .example.
.env
.env.*
!.env.example

# Coordinacion local entre agentes; no se versiona.
/logs/
