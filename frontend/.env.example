# Opcion recomendada: mismo origen y proxy de Next al backend.
# En desarrollo se puede usar http://localhost:8000 como URL publica directa.
NEXT_PUBLIC_API_URL=
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Variables sensibles (solo servidor). NO usar prefijo NEXT_PUBLIC
# BACKEND_API_KEY=your_api_key_here
# JWT_PRIVATE_KEY=your_private_key_here
